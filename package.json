{
  "name": "any-sidebar-for-windows",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/windows/web src/ui scripts tests vite.config.ts vitest.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "test:web": "vitest run",
    "test:native": "node scripts/native-checks.mjs",
    "test:e2e": "playwright test",
    "publish:windows": "node scripts/publish.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/decous37/Any-Sidebar-for-Windows.git"
  },
  "description": "轻量的 Windows AI 侧边栏，支持划词引用与手动读屏"
}
